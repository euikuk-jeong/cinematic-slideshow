{
  "expo": {
    "name": "Cinematic Slideshow",
    "slug": "cinematic-slideshow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekjeong.cinematicslideshow"
    },
    "android": {
      "package": "com.ekjeong.cinematicslideshow",
      "adaptiveIcon": {
        "backgroundColor": "#FC836D",
        "foregroundImage": "./assets/images/app-icon-adaptive-foreground-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/app-icon-1024.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "슬라이드쇼로 만들 사진에 접근하기 위해 필요합니다.",
          "savePhotosPermission": false,
          "granularPermissions": ["photo", "audio"]
        }
      ]
    ]
  }
}
