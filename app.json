{
  "expo": {
    "name": "Cinematic Slideshow",
    "slug": "cinematic-slideshow",
    "version": "0.9.0",
    "orientation": "default",
    "icon": "./assets/images/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekjeong.cinematicslideshow"
    },
    "android": {
      "package": "com.ekjeong.cinematicslideshow",
      "adaptiveIcon": {
        "backgroundColor": "#FC836D",
        "foregroundImage": "./assets/images/app-icon-adaptive-foreground-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/app-icon-1024.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "슬라이드쇼로 만들 사진에 접근하기 위해 필요합니다.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo",
            "audio"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48a72a91-aef8-4952-985c-f8c9a98d66f0"
      }
    },
    "owner": "euikuk.jeong"
  }
}
